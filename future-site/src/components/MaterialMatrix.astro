---
import { copy, materials, ui, type Lang } from "../data/site";
import { withBase } from "../utils/paths";
import ResponsiveImage from "./ResponsiveImage.astro";

const { lang } = Astro.props as { lang: Lang };
const text = ui[lang];
---

<section class="section material-section" aria-labelledby="material-heading">
  <div class="material-heading">
    <div>
      <p class="material-overline">Material matrix</p>
      <h2 id="material-heading">{copy[lang].materialsTitle}</h2>
    </div>
    <a class="material-all-link" href={withBase(`/${lang}/materials/`)}>
      <span>{text.allMaterialsLink}</span>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
    </a>
  </div>

  <div class="material-rail" aria-label={copy[lang].materialsTitle}>
    {materials.map((material) => (
      <a class="material-card" href={withBase(`/${lang}/materials/${material.slug}/`)}>
        <div class="material-media">
          <ResponsiveImage
            src={material.image}
            alt={material.name[lang]}
            widths={[128, 192, 256, 384]}
            sizes="(max-width: 680px) 72vw, (max-width: 1120px) 38vw, 17vw"
          />
        </div>
        <div class="material-copy">
          <p>{material.eyebrow[lang]}</p>
          <h3>{material.name[lang]}</h3>
          <span>{material.summary[lang]}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .material-section { padding-block: clamp(56px, 5vw, 76px); color: var(--text, #f3f3f3); background: var(--ink, #0b1013); }
  .material-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; max-width: 1360px; margin: 0 auto clamp(2.25rem, 4vw, 3.5rem); }
  .material-overline { margin: 0 0 .75rem; color: var(--accent, #e40012); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .material-heading h2 { max-width: 16ch; margin: 0; font-size: clamp(30px, 2.55vw, 40px); font-weight: 700; line-height: 1.3; letter-spacing: -.035em; }
  .material-all-link { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .6rem; padding: .55rem 0; border-bottom: 1px solid color-mix(in srgb, var(--accent, #e40012) 72%, transparent); color: var(--text, #f3f3f3); font-size: .88rem; font-weight: 700; transition: color 180ms ease, border-color 180ms ease; }
  .material-all-link svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; transition: transform 180ms ease; }
  .material-all-link:hover, .material-all-link:focus-visible { color: var(--accent, #e40012); }
  .material-all-link:hover svg, .material-all-link:focus-visible svg { transform: translateX(.2rem); }
  .material-rail { display: grid; grid-auto-columns: minmax(210px, 1fr); grid-auto-flow: column; gap: 1px; max-width: 1360px; margin: 0 auto; overflow-x: auto; overscroll-behavior-inline: contain; border: 1px solid var(--line, rgba(243, 243, 243, .18)); background: var(--line, rgba(243, 243, 243, .18)); scrollbar-color: color-mix(in srgb, var(--text, #f3f3f3) 42%, transparent) transparent; scrollbar-width: thin; }
  .material-card { display: grid; grid-template-rows: 180px auto; min-width: 0; padding: 1.1rem; color: inherit; background: var(--ink, #0b1013); transition: background 200ms ease, color 200ms ease; }
  .material-media { display: grid; place-items: center; min-width: 0; overflow: hidden; }
  .material-media :global(img) { width: min(100%, 150px); height: 150px; object-fit: contain; filter: grayscale(.35) contrast(1.04) drop-shadow(0 1.1rem 1.1rem rgba(0, 0, 0, .42)); transition: filter 240ms ease, transform 240ms ease; }
  .material-copy { padding-top: .95rem; border-top: 1px solid var(--line, rgba(243, 243, 243, .18)); }
  .material-copy p { min-height: 2.4em; margin: 0; color: var(--muted, #aeb5bb); font-size: .69rem; font-weight: 700; line-height: 1.35; letter-spacing: .055em; text-transform: uppercase; }
  .material-copy h3 { margin: .75rem 0 .7rem; font-size: 1.15rem; line-height: 1.25; }
  .material-copy span { display: -webkit-box; overflow: hidden; color: var(--muted, #aeb5bb); font-size: .83rem; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .material-card:hover, .material-card:focus-visible { background: #161d20; outline: none; }
  .material-card:hover .material-media :global(img), .material-card:focus-visible .material-media :global(img) { filter: grayscale(0) contrast(1.02) drop-shadow(0 1.3rem 1.25rem rgba(0, 0, 0, .54)); transform: translateY(-.3rem) scale(1.035); }
  .material-card:focus-visible { box-shadow: inset 0 0 0 2px var(--accent, #e40012); }
  @media (min-width: 1400px) { .material-rail { border-inline: 0; } }
  @media (max-width: 1120px) { .material-rail { margin-inline: calc(-1 * var(--site-gutter, 24px)); padding-inline: var(--site-gutter, 24px); border-inline: 0; } .material-card { grid-template-rows: 160px auto; } .material-media :global(img) { height: 136px; } }
  @media (max-width: 680px) { .material-heading { align-items: start; flex-direction: column; gap: 1rem; } .material-rail { grid-auto-columns: minmax(260px, 78vw); } .material-card { grid-template-rows: 175px auto; padding: 1.25rem; } }
</style>
