---
import { languages, nav, type Lang } from "../data/site";
import { withBase } from "../utils/paths";

const { lang, active } = Astro.props as { lang: Lang; active: string };
const homeHref = withBase(`/${lang}/`);
const brandLabel = "震欣科技股份有限公司 TANCHIN TECHNOLOGY CO., LTD";
const currentLanguage = languages.find((item) => item.lang === lang) ?? languages[0];
const navigationLabel = { zh: "導覽選單", en: "Navigation menu", ja: "ナビゲーションメニュー" }[lang];
const languageSelectionLabel = { zh: "選擇語言", en: "Language selection", ja: "言語を選択" }[lang];
---

<header class="site-header">
  <a class="brand-mark header-logo" href={homeHref} aria-label={brandLabel}>
    <span class="brand-logo-strip">
      <img
        class="brand-logo-emblem"
        src={withBase("/assets/brand/tanchin-logo-emblem-hires.png")}
        alt=""
        width="1383"
        height="1036"
      />
      <span class="brand-logo-name" aria-hidden="true">
        <strong>震欣科技股份有限公司</strong>
        <small>TANCHIN TECHNOLOGY CO., LTD</small>
      </span>
    </span>
  </a>

  <button
    class="nav-toggle"
    type="button"
    aria-label={navigationLabel}
    aria-expanded="false"
    aria-controls="site-navigation"
    data-nav-toggle
  >
    <span></span>
    <span></span>
  </button>

  <nav class="site-nav" id="site-navigation" aria-label={navigationLabel} data-site-nav>
    {nav[lang].map(([key, label, href]) => (
      <a class:list={{ active: active === key }} href={withBase(href)}>{label}</a>
    ))}
    <details class="language-menu">
      <summary class="language-pill">
        <span class="language-pill-wrap">
          <span class="language-pill-glow glow-1"></span>
          <span class="language-pill-glow glow-2"></span>
          <span class="language-pill-glow glow-3"></span>
          <span class="language-pill-glow glow-4"></span>
          <span class="language-pill-label">{currentLanguage.label}</span>
        </span>
      </summary>
      <div class="language-options" aria-label={languageSelectionLabel}>
        {languages.map((item) => (
          <a class:list={{ active: lang === item.lang }} href={withBase(item.href)}>{item.label}</a>
        ))}
      </div>
    </details>
  </nav>

  <noscript>
    <style>
      @media (max-width: 1180px) {
        .site-header { flex-wrap: wrap; }
        .site-header .nav-toggle { display: none; }
        .site-header .site-nav {
          position: static;
          display: grid;
          width: 100%;
          max-block-size: none;
          padding-bottom: 12px;
          overflow: visible;
        }
        .site-header .language-menu,
        .site-header .language-menu[open] .language-options { position: static; }
      }
    </style>
  </noscript>
</header>

<script>
  function setupNavigation() {
    const toggle = document.querySelector("[data-nav-toggle]");
    const nav = document.querySelector("[data-site-nav]");

    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) {
      return;
    }

    if (toggle.dataset.ready === "true") {
      return;
    }

    toggle.dataset.ready = "true";
    const languageMenu = nav.querySelector(".language-menu");
    const languageToggle = languageMenu?.querySelector("summary");

    const closeNavigation = (restoreFocus = false) => {
      const wasOpen = nav.classList.contains("open");
      const wasLanguageOpen = languageMenu instanceof HTMLDetailsElement && languageMenu.open;
      nav.classList.remove("open");
      toggle.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
      if (languageMenu instanceof HTMLDetailsElement) {
        languageMenu.open = false;
      }
      if (restoreFocus) {
        if (wasOpen) {
          toggle.focus();
        } else if (wasLanguageOpen && languageToggle instanceof HTMLElement) {
          languageToggle.focus();
        }
      }
    };

    const openNavigation = () => {
      nav.classList.add("open");
      toggle.classList.add("open");
      toggle.setAttribute("aria-expanded", "true");
      window.requestAnimationFrame(() => nav.querySelector<HTMLAnchorElement>("a")?.focus());
    };

    toggle.addEventListener("click", () => {
      if (nav.classList.contains("open")) {
        closeNavigation();
      } else {
        openNavigation();
      }
    });

    nav.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) {
        closeNavigation();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (target instanceof Node && !nav.contains(target) && !toggle.contains(target)) {
        closeNavigation();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") {
        return;
      }

      if (languageMenu instanceof HTMLDetailsElement && languageMenu.open) {
        languageMenu.open = false;
        if (languageToggle instanceof HTMLElement) {
          languageToggle.focus();
        }
        return;
      }

      closeNavigation(true);
    });

    const desktopMedia = window.matchMedia("(min-width: 1181px)");
    desktopMedia.addEventListener("change", (event) => {
      if (event.matches) {
        closeNavigation();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavigation, { once: true });
  } else {
    setupNavigation();
  }
</script>
