---
import { stats, type Lang } from "../data/site";
const { lang } = Astro.props as { lang: Lang };
---

<section class="stats-band" aria-label={{ zh: "製造能力佐證", en: "Manufacturing proof points", ja: "製造能力の根拠" }[lang]}>
  <div class="stats-grid">
    {stats.map((item) => (
      <div class="stat-card">
        <strong>{item.value}</strong>
        <span>{item[lang]}</span>
      </div>
    ))}
  </div>
</section>
