---
import { applicationCases, buyerSignals, serviceSteps, ui, type Lang } from "../data/site";
import { withBase } from "../utils/paths";
import ResponsiveImage from "./ResponsiveImage.astro";

const { lang, compact = false } = Astro.props as { lang: Lang; compact?: boolean };
const cases = compact ? applicationCases.slice(0, 3) : applicationCases;
const text = ui[lang];
---

<section class:list={["section", "application-section", compact && "application-section--compact"]} aria-labelledby="application-heading">
  <div class="application-intro">
    <div>
      <p class="application-overline">{text.applicationEyebrow}</p>
      <h2 id="application-heading">{text.applicationTitle}</h2>
      {!compact && <p class="application-description">{text.applicationText}</p>}
    </div>
    {compact && (
      <a class="application-all-link" href={withBase(`/${lang}/applications/`)}>
        <span>{text.applicationCompactLink}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
      </a>
    )}
  </div>

  <div class="application-grid">
    {cases.map((item) => (
      compact ? (
        <a class="application-card application-card--compact" href={withBase(`/${lang}/applications/#${item.id}`)}>
          <div class="application-image"><ResponsiveImage src={item.image} alt={item.title[lang]} widths={[160, 240, 320, 480, 640]} sizes="(max-width: 680px) 75vw, (max-width: 1120px) 31vw, 22vw" /></div>
          <div class="application-copy"><p>{item.industry[lang]}</p><h3>{item.title[lang]}</h3><span>{item.challenge[lang]}</span></div>
        </a>
      ) : (
        <article class="application-card" id={item.id}>
          <div class="application-image"><ResponsiveImage src={item.image} alt={item.title[lang]} widths={[160, 240, 320, 480, 640, 768, 960]} sizes="(max-width: 720px) 76vw, (max-width: 1100px) 35vw, 25vw" /></div>
          <div class="application-copy">
            <p>{item.industry[lang]}</p><h3>{item.title[lang]}</h3>
            <dl><div><dt>{text.challengeLabel}</dt><dd>{item.challenge[lang]}</dd></div><div><dt>{text.approachLabel}</dt><dd>{item.solution[lang]}</dd></div></dl>
            <ul class="evidence-list">{item.evidence[lang].map((evidence) => <li>{evidence}</li>)}</ul>
          </div>
        </article>
      )
    ))}
  </div>
</section>

{!compact && (
  <section class="section service-section">
    <div class="section-heading">
      <p class="eyebrow">{text.serviceEyebrow}</p>
      <h2>{text.serviceTitle}</h2>
      <p>{text.serviceText}</p>
    </div>
    <div class="service-flow">
      {serviceSteps.map((step, index) => (
        <article class="service-step">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title[lang]}</h3>
          <p>{step.text[lang]}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section buyer-section">
    <div class="buyer-map">
      {buyerSignals.map((signal) => (
        <article>
          <h3>{signal[lang][0]}</h3>
          <p>{signal[lang][1]}</p>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .application-section { color: var(--ink-text, #11161a); background: var(--paper, #f3f3f3); }
  .application-section--compact { padding-block: clamp(56px, 5vw, 76px); }
  .application-intro { display: grid; grid-template-columns: minmax(0, .78fr) minmax(210px, .22fr); align-items: end; gap: 2rem; max-width: 1360px; margin: 0 auto clamp(2.3rem, 4vw, 3.7rem); }
  .application-overline { margin: 0 0 .75rem; color: var(--accent, #e40012); font-size: .72rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .application-intro h2 { max-width: 15ch; margin: 0; font-size: clamp(30px, 2.55vw, 40px); font-weight: 700; line-height: 1.3; letter-spacing: -.035em; }
  .application-description { max-width: 70ch; margin: 1.4rem 0 0; color: color-mix(in srgb, var(--ink-text, #11161a) 69%, transparent); line-height: 1.75; }
  .application-all-link { display: inline-flex; align-items: center; justify-self: end; gap: .6rem; padding: .55rem 0; border-bottom: 1px solid color-mix(in srgb, var(--accent, #e40012) 72%, transparent); color: inherit; font-size: .88rem; font-weight: 700; transition: color 180ms ease; }
  .application-all-link svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; transition: transform 180ms ease; }
  .application-all-link:hover, .application-all-link:focus-visible { color: var(--accent, #e40012); }
  .application-all-link:hover svg, .application-all-link:focus-visible svg { transform: translateX(.2rem); }
  .application-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.75rem); max-width: 1360px; margin: 0 auto; }
  .application-card { display: grid; min-width: 0; border: 1px solid var(--line-dark, rgba(11, 16, 19, .16)); color: inherit; background: var(--paper-strong, #fff); }
  .application-card--compact { grid-template-rows: 220px auto; transition: box-shadow 200ms ease, transform 200ms ease; }
  .application-image { display: grid; min-width: 0; place-items: center; overflow: hidden; background: #e8e9e8; }
  .application-image :global(img) { width: 77%; height: 172px; object-fit: contain; filter: grayscale(.45) contrast(1.04) drop-shadow(0 1rem 1rem rgba(0, 0, 0, .28)); transition: filter 220ms ease, transform 220ms ease; }
  .application-copy { padding: 1.35rem 1.35rem 1.55rem; }
  .application-copy > p { margin: 0; color: var(--accent, #e40012); font-size: .7rem; font-weight: 800; line-height: 1.4; letter-spacing: .07em; text-transform: uppercase; }
  .application-copy h3 { margin: .8rem 0 0; font-size: clamp(1.1rem, 1.55vw, 1.35rem); line-height: 1.35; letter-spacing: -.02em; }
  .application-card--compact .application-copy > span { display: -webkit-box; overflow: hidden; margin-top: .75rem; color: color-mix(in srgb, var(--ink-text, #11161a) 65%, transparent); font-size: .88rem; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .application-card--compact:hover, .application-card--compact:focus-visible { box-shadow: 0 1rem 2rem rgba(11, 16, 19, .12); transform: translateY(-.28rem); outline: none; }
  .application-card--compact:focus-visible { box-shadow: 0 0 0 2px var(--accent, #e40012), 0 1rem 2rem rgba(11, 16, 19, .12); }
  .application-card--compact:hover .application-image :global(img), .application-card--compact:focus-visible .application-image :global(img) { filter: grayscale(0) contrast(1.02) drop-shadow(0 1.05rem 1rem rgba(0, 0, 0, .34)); transform: translateY(-.25rem) scale(1.03); }
  .application-card:not(.application-card--compact) { grid-template-rows: 210px auto; }
  .application-card:not(.application-card--compact) .application-copy { padding: 1.5rem; }
  .application-card:not(.application-card--compact) dl { display: grid; gap: 1rem; margin: 1.2rem 0 0; }
  .application-card:not(.application-card--compact) dt { font-size: .74rem; font-weight: 800; }
  .application-card:not(.application-card--compact) dd { margin: .35rem 0 0; color: color-mix(in srgb, var(--ink-text, #11161a) 70%, transparent); font-size: .9rem; line-height: 1.65; }
  .evidence-list { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1.4rem 0 0; padding: 0; list-style: none; }
  .evidence-list li { padding: .35rem .5rem; border: 1px solid var(--line-dark, rgba(11, 16, 19, .16)); color: color-mix(in srgb, var(--ink-text, #11161a) 72%, transparent); font-size: .72rem; }
  @media (min-width: 1120px) {
    .application-section--compact { display: grid; grid-template-columns: minmax(0, .24fr) minmax(0, .76fr); align-items: start; gap: clamp(2rem, 5vw, 5.5rem); }
    .application-section--compact .application-intro { display: block; margin: 0; }
    .application-section--compact .application-intro h2 { max-width: 9ch; }
    .application-section--compact .application-all-link { justify-self: auto; margin-top: 1.75rem; }
    .application-section--compact .application-grid { max-width: none; }
    .application-section--compact .application-card--compact { grid-template-rows: 190px auto; }
    .application-section--compact .application-image :global(img) { height: 145px; }
  }
  @media (max-width: 920px) { .application-intro { grid-template-columns: 1fr; } .application-all-link { justify-self: start; } .application-grid { grid-template-columns: 1fr; } .application-card--compact { grid-template-columns: minmax(220px, .75fr) 1fr; grid-template-rows: 1fr; } .application-card--compact .application-image { min-height: 230px; } }
  @media (max-width: 680px) { .application-card--compact { grid-template-columns: 1fr; } .application-card--compact .application-image { min-height: 215px; } }
</style>
