---
import { getImage } from "astro:assets";
import powderStage from "../assets/images/mim-powder-aggregation.png";
import formedStage from "../assets/images/mim-powder-stage.png";
import sinteredStage from "../assets/images/mim-vacuum-transition.png";
import { copy, type Lang } from "../data/site";
import { withBase } from "../utils/paths";

const { lang } = Astro.props as { lang: Lang };
const c = copy[lang];
const stageWidths = [640, 960, 1374];
const stageSizes = "(max-width: 760px) 100vw, (max-width: 1120px) 82vw, 52vw";
const makeStageSource = async (src: typeof powderStage) => {
  const variants = await Promise.all(stageWidths.map((width) => getImage({ src, width, format: "webp" })));
  return {
    src: variants.at(-1)?.src ?? variants[0].src,
    srcset: variants.map((variant, index) => `${variant.src} ${stageWidths[index]}w`).join(", "),
    sizes: stageSizes,
    width: src.width,
    height: src.height
  };
};
const stageSources = await Promise.all([
  makeStageSource(powderStage),
  makeStageSource(formedStage),
  makeStageSource(sinteredStage)
]);
const labels = {
  zh: {
    visual: "金屬粉末逐步形成精密 MIM 零件的製程視覺",
    pause: "暫停",
    replay: "重播",
    paused: "製程動畫已暫停",
    replayed: "從金屬粉末階段重新播放",
    phases: ["金屬粉末", "射出成形", "真空燒結"]
  },
  en: {
    visual: "Process view of metal powder forming into a precision MIM component",
    pause: "Pause",
    replay: "Replay",
    paused: "Process animation paused",
    replayed: "Process replayed from the powder phase",
    phases: ["Powder", "Form", "Vacuum sintering"]
  },
  ja: {
    visual: "金属粉末から精密 MIM 部品が形成される工程イメージ",
    pause: "一時停止",
    replay: "もう一度見る",
    paused: "工程アニメーションを一時停止しました",
    replayed: "金属粉末の段階から再生しました",
    phases: ["金属粉末", "射出成形", "真空焼結"]
  }
}[lang];
---

<section
  class="mim-hero is-static"
  data-metal-hero
  data-phase="2"
  data-pause-label={labels.pause}
  data-replay-label={labels.replay}
  data-paused-message={labels.paused}
  data-replayed-message={labels.replayed}
  data-metal-sources={JSON.stringify(stageSources)}
>
  <div class="mim-hero__inner">
    <div class="mim-hero__copy">
      <h1>{c.heroTitle}</h1>
      <p>{c.heroText}</p>
      <div class="mim-hero__actions">
        <a class="mim-hero__cta mim-hero__cta--primary" href={withBase(`/${lang}/contact/`)}>{c.primaryCta}</a>
        <a class="mim-hero__cta mim-hero__cta--secondary" href={withBase(`/${lang}/materials/`)}>{c.secondaryCta}</a>
      </div>
    </div>

    <figure class="mim-hero__visual" aria-label={labels.visual}>
      <div class="mim-hero__poster" data-metal-stage>
        <div class="mim-hero__media is-active" data-metal-image-slot aria-hidden="true">
          <img
            src={stageSources[2].src}
            srcset={stageSources[2].srcset}
            sizes={stageSizes}
            width={sinteredStage.width}
            height={sinteredStage.height}
            alt=""
            loading="eager"
            fetchpriority="auto"
            decoding="async"
            data-metal-stage-image="2"
          />
        </div>
        <div class="mim-hero__media" data-metal-image-slot aria-hidden="true"></div>
        <canvas class="mim-hero__canvas" data-metal-canvas aria-hidden="true"></canvas>
        <span class="mim-hero__datum" aria-hidden="true"></span>
      </div>

      <div class="mim-hero__controls" data-metal-controls>
        <button class="mim-hero__playback" type="button" data-metal-playback aria-label={labels.pause}>
          <svg class="mim-hero__pause-icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4.25 2.5h2.1v11h-2.1zM9.65 2.5h2.1v11h-2.1z"></path>
          </svg>
          <svg class="mim-hero__replay-icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M13.25 3.1v3.7h-3.7"></path>
            <path d="M12.2 6.1A5.15 5.15 0 1 0 12 11"></path>
          </svg>
          <span data-metal-playback-label>{labels.pause}</span>
        </button>

        <div class="mim-hero__phases" aria-label={labels.visual}>
          {labels.phases.map((phase, index) => (
            <button
              class="mim-hero__phase"
              type="button"
              data-metal-phase={index}
              aria-pressed={index === 2 ? "true" : "false"}
            >
              <span class="mim-hero__phase-index" aria-hidden="true">0{index + 1}</span>
              <span>{phase}</span>
            </button>
          ))}
        </div>
      </div>
      <span class="mim-hero__sr-only" data-metal-status aria-live="polite"></span>
    </figure>
  </div>
</section>

<script>
  import "../scripts/metal-hero";
</script>

<style>
  .mim-hero {
    --mim-accent: var(--color-accent, #e40012);
    --mim-copy: #f4f5f3;
    --mim-muted: #aeb5b8;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 610px;
    background: #0b1013;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mim-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 76% 48%, rgba(108, 119, 124, 0.1), transparent 30%), linear-gradient(90deg, rgba(11, 16, 19, 0.98) 0%, rgba(11, 16, 19, 0.92) 40%, rgba(11, 16, 19, 0.16) 68%, transparent 100%);
    pointer-events: none;
    content: "";
  }

  .mim-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: center;
    width: min(calc(100% - clamp(44px, 7.5vw, 112px)), var(--site-max-width, 1320px));
    min-height: 610px;
    margin: 0 auto;
    padding: 48px 0 42px;
  }

  .mim-hero__copy {
    position: relative;
    z-index: 3;
    max-width: 620px;
  }

  .mim-hero__copy h1 {
    max-width: 10.5em;
    margin: 0;
    color: var(--mim-copy);
    font-family: var(--font-display, var(--font-sans, inherit));
    font-size: clamp(44px, 4.3vw, 68px);
    font-weight: 760;
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .mim-hero__copy > p {
    max-width: 590px;
    margin: 24px 0 0;
    color: var(--mim-muted);
    font-family: var(--font-sans, inherit);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.85;
    letter-spacing: 0.01em;
  }

  .mim-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .mim-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    color: var(--mim-copy);
    font-family: var(--font-sans, inherit);
    font-size: 14px;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 0;
    transition: color 180ms ease, border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .mim-hero__cta:hover { transform: translateY(-2px); }

  .mim-hero__cta:focus-visible,
  .mim-hero__playback:focus-visible,
  .mim-hero__phase:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .mim-hero__cta--primary {
    color: #ffffff;
    border-color: var(--mim-accent);
    background: var(--mim-accent);
  }

  .mim-hero__cta--primary:hover {
    border-color: #ff2635;
    background: #c90010;
  }

  .mim-hero__cta--secondary { background: rgba(255, 255, 255, 0.015); }

  .mim-hero__cta--secondary:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.06);
  }

  .mim-hero__visual {
    position: relative;
    z-index: 1;
    min-width: 0;
    margin: 0;
  }

  .mim-hero__poster {
    position: relative;
    height: clamp(390px, 38vw, 520px);
    overflow: visible;
    transform: translate3d(var(--mim-parallax-x, 0), var(--mim-parallax-y, 0), 0);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .mim-hero__media {
    position: absolute;
    inset: -5% -7% -5% -13%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 760ms ease, visibility 0s linear 760ms;
  }

  .mim-hero__media :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    /* Fade only the bitmap margins, including when its frame is letterboxed. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent), linear-gradient(0deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent), linear-gradient(0deg, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .mim-hero__media.is-active {
    z-index: 2;
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  .mim-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
  }

  .mim-hero__datum {
    position: absolute;
    top: 48%;
    left: -7%;
    width: 34%;
    height: 1px;
    z-index: 4;
    background: linear-gradient(90deg, transparent, rgba(228, 0, 18, 0.92) 22%, rgba(228, 0, 18, 0.48));
    transform: scaleX(0.58);
    transform-origin: right center;
    opacity: 0.78;
    transition: transform 900ms ease, opacity 500ms ease;
  }

  .mim-hero__datum::after {
    position: absolute;
    top: 50%;
    right: -3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mim-accent);
    box-shadow: 0 0 12px rgba(228, 0, 18, 0.42);
    transform: translateY(-50%);
    content: "";
  }

  .mim-hero[data-phase="1"] .mim-hero__datum { transform: scaleX(0.82); }
  .mim-hero[data-phase="2"] .mim-hero__datum { transform: scaleX(1); }

  .mim-hero__controls {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 22px;
    width: min(100%, 590px);
    margin: -4px auto 0;
    color: #d7dadb;
    font-family: var(--font-sans, inherit);
  }

  .mim-hero__playback,
  .mim-hero__phase {
    padding: 0;
    color: inherit;
    font: inherit;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .mim-hero__playback {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 8px;
    align-items: center;
    min-height: 38px;
    color: #f1f2f2;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .mim-hero__playback svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .mim-hero__replay-icon {
    display: none;
    fill: none !important;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.4;
  }

  .mim-hero.is-paused .mim-hero__pause-icon { display: none; }
  .mim-hero.is-paused .mim-hero__replay-icon { display: block; }

  .mim-hero__phases {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .mim-hero__phase {
    position: relative;
    min-height: 42px;
    color: #8e979b;
    font-size: 11px;
    font-weight: 600;
    text-align: left;
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    transition: color 200ms ease, border-color 200ms ease;
  }

  :global(html[lang="en"]) .mim-hero__phase {
    font-size: 10px;
  }

  .mim-hero__phase:hover {
    color: #d7dadb;
    border-color: rgba(255, 255, 255, 0.56);
  }

  .mim-hero__phase[aria-pressed="true"] {
    color: #ffffff;
    border-color: var(--mim-accent);
  }

  .mim-hero__phase-index {
    display: inline-block;
    margin-right: 6px;
    color: var(--mim-accent);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .mim-hero__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mim-hero.is-static .mim-hero__canvas,
  .mim-hero.is-static .mim-hero__controls { display: none; }

  .mim-hero.is-manual .mim-hero__canvas,
  .mim-hero.is-manual .mim-hero__playback { display: none; }

  @media (max-width: 1120px) {
    .mim-hero__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 20px;
    }

    .mim-hero__copy h1 { font-size: clamp(38px, 5vw, 54px); }
    .mim-hero__poster { height: clamp(380px, 45vw, 500px); }
  }

  @media (max-width: 820px) {
    .mim-hero { min-height: auto; }

    .mim-hero::before {
      background: linear-gradient(180deg, #0b1013 0%, rgba(11, 16, 19, 0.5) 62%, #0b1013 100%);
    }

    .mim-hero__inner {
      grid-template-columns: 1fr;
      gap: 18px;
      width: min(calc(100% - 40px), 680px);
      min-height: auto;
      padding: 64px 0 34px;
    }

    .mim-hero__copy { max-width: 650px; }

    .mim-hero__copy h1 {
      max-width: 12em;
      font-size: clamp(38px, 8.5vw, 54px);
    }

    .mim-hero__copy > p {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.75;
    }

    .mim-hero__actions { margin-top: 26px; }
    .mim-hero__poster { height: clamp(330px, 68vw, 470px); }
    .mim-hero__media { inset: -4% -12% -4% -12%; }
    .mim-hero__controls { width: 100%; }
  }

  @media (max-width: 560px) {
    .mim-hero__inner {
      width: calc(100% - 36px);
      padding-top: 48px;
    }

    .mim-hero__copy h1 {
      max-width: 11em;
      font-size: clamp(34px, 10.3vw, 44px);
      letter-spacing: -0.035em;
    }

    .mim-hero__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .mim-hero__poster {
      height: min(96vw, 410px);
      margin-inline: -18px;
    }

    .mim-hero__media { inset: 0 -4%; }

    .mim-hero__controls {
      display: block;
      margin-top: 4px;
    }

    .mim-hero__playback { margin-bottom: 8px; }
    .mim-hero__phases { gap: 8px; }

    .mim-hero__phase {
      min-height: 46px;
      font-size: 10px;
    }

    .mim-hero__phase-index {
      display: block;
      margin: 0 0 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mim-hero__poster,
    .mim-hero__media,
    .mim-hero__datum,
    .mim-hero__cta { transition: none; }
  }
</style>
