---
import Layout from "../../layouts/Layout.astro";
import { equipment } from "../../data/site";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
---

<Layout lang="ja" title="設備・製造体制 | TANCHIN" description="TANCHINは射出成形、真空焼結、後加工、検査まで一貫して対応します。" active="equipment">
  <section class="page-hero">
    <p class="eyebrow">Equipment</p>
    <h1>MIMの安定量産を支える設備・製造体制</h1>
    <p>射出成形、焼結、後加工、検査までの一貫体制により、カスタム部品の安定製造を支えます。</p>
  </section>
  <section class="section narrow equipment-grid">
    {equipment.map((item) => (
      <article class="feature-panel">
        <ResponsiveImage src={item.image} alt={item.ja[0]} widths={[200, 300, 350, 500]} sizes="(max-width: 720px) 100vw, 50vw" />
        <h2>{item.ja[0]}</h2>
        <p>{item.ja[1]}</p>
      </article>
    ))}
  </section>
</Layout>
